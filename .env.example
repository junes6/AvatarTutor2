# ─────────────────────────────────────────────────────────────
# 아바타튜터 환경변수
# 이 파일을 .env.local 로 복사한 뒤 실제 키를 채워 넣으세요.
# 키가 하나도 없어도 앱은 "목(mock) 모드"로 전체 흐름이 동작합니다.
# ─────────────────────────────────────────────────────────────

# ── 두뇌 (LLM) — Anthropic Claude ──
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# 기본 모델 (미설정 시 claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
# 사고 모드: disabled(기본, 저지연) | adaptive
ANTHROPIC_THINKING=disabled

# ── 귀 (STT) + 입 (TTS) — OpenAI ──
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# STT 모델 (기본 gpt-4o-transcribe, 실패 시 whisper-1 자동 폴백)
OPENAI_STT_MODEL=gpt-4o-transcribe
# TTS 모델 (기본 gpt-4o-mini-tts)
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── TTS 교체 어댑터 — ElevenLabs (선택) ──
# 발급: https://elevenlabs.io → Profile → API Keys
# TTS_PROVIDER=elevenlabs 로 바꾸면 ElevenLabs 사용
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=

# ── 발음 평가 — Azure Speech (선택) ──
# 발급: https://portal.azure.com → Speech Service 리소스 생성
# 키가 없으면 STT 재인식 유사도로 근사 채점(폴백)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# ── 아바타 레이어 (0 | 1 | 2 | auto) ──
# 0: 프로필 사진 + 파형/입모양 애니메이션 (무료, 기본)
# 1: 사전 생성 아이들/토킹 루프 영상 (public/avatars/video/{id}-idle.mp4, {id}-talk.mp4)
# 2: 실시간 아바타 API (Anam / Simli — 아래 키 필요)
# auto: 키/파일 존재 여부로 자동 선택
NEXT_PUBLIC_AVATAR_LAYER=auto

# ── L2 실시간 아바타 (선택) ──
# Anam 무료 개발자 티어: https://anam.ai
# Simli 무료 티어: https://simli.com
AVATAR_L2_PROVIDER=anam
ANAM_API_KEY=
SIMLI_API_KEY=

# ── 웹 푸시 (PWA 알림, 선택) ──
# 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
