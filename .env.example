# ─────────────────────────────────────────────────────────────
# 아바타튜터 환경변수
# 이 파일을 .env.local 로 복사한 뒤 실제 키를 채워 넣으세요.
# 키가 하나도 없어도 전체 흐름은 동작하지만, 앱 상단에 "데모 모드" 배너가 상시 표시됩니다.
# 실연동 여부는 npm run health 또는 GET /api/health 로 실제 호출을 통해 확인합니다.
# ─────────────────────────────────────────────────────────────

# ── 두뇌 (LLM) ──
# auto: Anthropic 키가 있으면 Anthropic, 없고 OpenAI 키가 있으면 OpenAI, 둘 다 없으면 mock
# openai 키 하나로 두뇌 + STT + TTS를 함께 사용할 수 있습니다.
LLM_PROVIDER=auto

# Anthropic을 선택할 때만 필요 (선택)
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# 기본 모델 (미설정 시 claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
# 사고 모드: disabled(기본, 저지연) | adaptive
ANTHROPIC_THINKING=disabled

# ── OpenAI 두뇌 + 귀 (STT) + 입 (TTS) ──
# 발급: https://platform.openai.com/api-keys
# 표준 API 키이며 절대 NEXT_PUBLIC_ 변수나 브라우저 코드에 넣지 마세요.
OPENAI_API_KEY=
# 현재 파이프라인용 저지연 회화 두뇌
OPENAI_LLM_MODEL=gpt-5.6-terra
# STT 모델 (기본 gpt-4o-transcribe, 실패 시 whisper-1 자동 폴백)
OPENAI_STT_MODEL=gpt-4o-transcribe
# TTS 모델 (기본 gpt-4o-mini-tts)
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── OpenAI Realtime WebRTC 파일럿 ──
# 서버 연결부: POST /api/realtime/call?sessionId=...
# 학습 진도 저장을 보호하기 위해 현재는 freetalk 세션에만 허용합니다.
OPENAI_REALTIME_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe

# ── TTS 교체 어댑터 — ElevenLabs (선택) ──
# 발급: https://elevenlabs.io → Profile → API Keys
# TTS_PROVIDER=elevenlabs 로 바꾸면 ElevenLabs 사용
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=

# ── 발음 평가 — Azure Speech (선택) ──
# 발급: https://portal.azure.com → Speech Service 리소스 생성
# 키가 없으면 STT 재인식 유사도로 근사 채점(폴백)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# ── 아바타 레이어 (0 | 1 | 2 | auto) ──
# 0: 프로필 사진 + 파형/입모양 애니메이션 (무료, 기본)
# 1: 사전 생성 아이들/토킹 루프 영상 (public/avatars/video/{id}-idle.mp4, {id}-talk.mp4)
# 2: 실시간 아바타 API (Anam / Simli — 아래 키 필요)
# auto: 키/파일 존재 여부로 자동 선택
NEXT_PUBLIC_AVATAR_LAYER=auto

# ── L2 실시간 아바타 (선택) ──
# Anam 무료 개발자 티어: https://anam.ai
# Simli 무료 티어: https://simli.com
AVATAR_L2_PROVIDER=anam
ANAM_API_KEY=
SIMLI_API_KEY=

# ── 친구의 근황 사진 (선택) ──
# 튜터의 여행·일상 사진을 실제 사진으로 채웁니다.
# 키가 없으면 public/photos/ 의 로컬 샘플 일러스트로 폴백하고, UI에 그 사실을 표시합니다.
# Unsplash 무료 키: https://unsplash.com/developers  (사진가 크레딧 표기가 의무입니다)
UNSPLASH_ACCESS_KEY=
# Pexels 무료 키: https://www.pexels.com/api/  (Unsplash 키가 없을 때 2순위로 사용)
PEXELS_API_KEY=

# ── 비동기 응답(카톡형 시간 텀) 튜닝 ──
# 0으로 두면 지연 큐를 끄고 답장이 즉시 옵니다 (개발 중 흐름 확인용).
CHAT_DELAY_ENABLED=1
# "지금 대화 중" 토글이 무입력 상태에서 자동 해제되기까지의 시간 (ms)
CHAT_LIVE_WINDOW_MS=300000
# 서버가 켜져 있으면 60초마다 예약 답장을 도착시키고 푸시를 보냅니다 (브라우저를 닫아도 대화가 이어짐).
# 0으로 두면 클라이언트가 앱을 열고 있을 때만 도착합니다.
CHAT_SCHEDULER_ENABLED=1
# 채팅방을 나간 뒤 새 친구가 먼저 말을 걸기까지의 지연 (ms).
# 비워 두면 남은 친구가 있을 때 3~24시간, 아무도 없으면 20~60분 사이에서 자동으로 정합니다.
FRIEND_INTRO_DELAY_MS=

# ── 웹 푸시 (PWA 알림, 선택) ──
# 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── 카카오톡 연결 (선택) ──
# JavaScript SDK 키와 채널 Public ID를 넣으면 앱의 카카오 버튼이
# 해당 채널의 새 1:1 채팅을 엽니다(앱 대화 기록은 전달하지 않음).
# 키가 없을 때는 공유/복사로 폴백합니다.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
NEXT_PUBLIC_KAKAO_CHANNEL_ID=
# 공개 HTTPS 배포 주소. 카카오 상태 점검과 공유 링크의 기준 주소로 사용합니다.
NEXT_PUBLIC_APP_URL=
# 운영 환경 필수. 챗봇 관리자센터 스킬 헤더의 x-avatar-tutor-secret 값과 일치시킵니다.
KAKAO_SKILL_SECRET=

# 공개 배포 시 개인 웹 앱/API를 보호하는 HTTP Basic 인증 (운영 환경 필수).
# 로컬/LAN 개발에서도 두 값을 모두 설정하면 같은 인증이 적용됩니다.
# 카카오 스킬 엔드포인트는 이 인증 대신 KAKAO_SKILL_SECRET을 사용합니다.
APP_BASIC_USER=
APP_BASIC_PASSWORD=

# 세션 원문 로그 저장 위치 (미설정 시 프로젝트의 logs/). 운영에서는 암호화된 영속 볼륨 권장.
SESSION_LOG_DIR=
